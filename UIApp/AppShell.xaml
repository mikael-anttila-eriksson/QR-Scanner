<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UIApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UIApp.Views"
    Title="UIApp">

    <TabBar>
        <ShellContent
            Title="Scan"
            Icon="icon_scan.png"
            ContentTemplate="{DataTemplate local:ScannerPage}"
            Route="scanner" />

        <ShellContent
            Title="History"
            Icon="icon_history.png"
            ContentTemplate="{DataTemplate local:HistoryPage}"
            Route="history" />

        <ShellContent
            Title="Generator"
            Icon="icon_generate.png"
            ContentTemplate="{DataTemplate local:GeneratorPage}"
            Route="generator" />

        <ShellContent
            Title="Settings"
            Icon="icon_settings.png"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
