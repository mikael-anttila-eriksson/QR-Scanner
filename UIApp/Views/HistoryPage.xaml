<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UIApp.Models"
             xmlns:conv="clr-namespace:UIApp.Converters"
             x:Class="UIApp.Views.HistoryPage"
             x:Name="QRHistoryPage"
             Title="History">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:TimeAgoConverter x:Key="TimeAgoConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="12">
            <!-- Top Control Bar -->
            <VerticalStackLayout Spacing="12">
                <!-- Filter and Clear Row -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalOptions="Fill">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Favorites only" VerticalOptions="Center" TextColor="#ccc" />
                        <Switch IsToggled="{Binding ShowFavoritesOnly}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="Clear All" Command="{Binding ClearAllCommand}" BackgroundColor="#e53935" TextColor="#fff" Padding="12,8" CornerRadius="6" FontSize="13" />
                </Grid>

                <!-- Empty State -->
                <StackLayout IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="No scans yet" HorizontalOptions="Center" TextColor="#888" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Open the Scanner tab to create new scans." HorizontalOptions="Center" TextColor="#666" FontSize="12" />
                </StackLayout>
            </VerticalStackLayout>

            <!-- List Container with Border -->
            <Border Grid.Row="1" 
                    Stroke="#333" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 10" 
                    IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"
                    Padding="0">
                <CollectionView ItemsSource="{Binding Items}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ScanResult">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Delete" BackgroundColor="#e53935" Command="{Binding Source={x:Reference QRHistoryPage}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Padding="12" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding RawValue}" LineBreakMode="TailTruncation" TextColor="#fff" FontSize="14" />
                                    </StackLayout>

                                    <!-- Favorite star -->
                                    <Label Grid.Column="1" Text="★" TextColor="#FFD700" VerticalOptions="Center" IsVisible="{Binding IsFavorite}" Margin="8,0" />

                                    <Label Grid.Column="2" Text="{Binding ScannedAt, Converter={StaticResource TimeAgoConverter}}" TextColor="#aaa" HorizontalOptions="End" VerticalOptions="Center" FontSize="12" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference QRHistoryPage}, Path=BindingContext.ItemSelectedCommand}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>