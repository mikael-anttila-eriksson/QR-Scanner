<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:UIApp.ViewModels"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    x:Class="UIApp.Views.ScannerPage"
    x:DataType="vm:ScannerViewModel"
    Title="Scan"
    BackgroundColor="#1e1e1e">

    <Grid RowDefinitions="*,Auto" Padding="0">
        <!-- Camera View with Overlay -->
        <Grid RowDefinitions="*" ColumnDefinitions="*">
            <!-- Full-screen camera preview -->
            <zxing:CameraBarcodeReaderView 
                x:Name="CameraBarcodeReaderView"
                BarcodesDetected="OnBarcodesDetected"
                IsEnabled="{Binding IsScanningEnabled}"
                Grid.Row="0"
                Grid.Column="0">
                <zxing:CameraBarcodeReaderView.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                </zxing:CameraBarcodeReaderView.GestureRecognizers>
            </zxing:CameraBarcodeReaderView>

            <!-- Semi-transparent overlay outside viewfinder -->
            <BoxView 
                Grid.Row="0" 
                Grid.Column="0"
                BackgroundColor="#00000080"
                IsVisible="{Binding IsOverlayVisible}" />

            <!-- Permission overlay content -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsOverlayVisible}">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="24" BackgroundColor="#222222cc" Spacing="12" WidthRequest="300">
                    <Label Text="Camera required" TextColor="#fff" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="This app needs access to the camera to scan QR codes. Please grant camera permission in app settings." TextColor="#ddd" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Button Text="Open Settings" Command="{Binding OpenAppSettingsCommand}" BackgroundColor="#2196F3" TextColor="#fff" />
                </StackLayout>
            </Grid>

            <!-- Torch toggle button (top-right corner) -->
            <Button 
                Grid.Row="0"
                Grid.Column="0"
                Text="{Binding TorchButtonText}"
                Command="{Binding ToggleTorchCommand}"
                IsEnabled="{Binding IsTorchSupported}"
                BackgroundColor="#FF8C00"
                TextColor="#ffffff"
                FontSize="16"
                Padding="12,8"
                CornerRadius="24"
                BorderWidth="0"
                VerticalOptions="Start"
                HorizontalOptions="End"
                Margin="0,16,16,0" />

            <!-- Viewfinder rectangle (border only) -->
            <Border 
                Grid.Row="0"
                Grid.Column="0"
                Margin="40"
                Stroke="#00ff00"
                StrokeThickness="3">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
            </Border>
        </Grid>

        <!-- Status text and Gallery button at bottom -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="0" BackgroundColor="#2a2a2a">
            <Label 
                Grid.Column="0"
                Text="{Binding StatusMessage}"
                TextColor="#ffffff"
                FontSize="14"
                HorizontalTextAlignment="Center"
                Padding="20,16"
                VerticalOptions="Center" />
            
            <!-- Gallery button -->
            <Button 
                Grid.Column="1"
                Text="📷 Gallery"
                Command="{Binding PickGalleryImageCommand}"
                BackgroundColor="#2196F3"
                TextColor="#ffffff"
                FontSize="12"
                Padding="12,16"
                CornerRadius="0"
                BorderWidth="0"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>